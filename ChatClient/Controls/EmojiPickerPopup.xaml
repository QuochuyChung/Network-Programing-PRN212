<UserControl x:Class="ChatClient.Controls.EmojiPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             Width="330" Height="280">
    <UserControl.Resources>
        <Style x:Key="CategoryTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmojiItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton Style="{StaticResource CategoryTabStyle}" IsChecked="True" Checked="OnTabSmileysChecked">
                        <emoji:TextBlock Text="😀" FontSize="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CategoryTabStyle}" Checked="OnTabGesturesChecked">
                        <emoji:TextBlock Text="👍" FontSize="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CategoryTabStyle}" Checked="OnTabHeartsChecked">
                        <emoji:TextBlock Text="❤️" FontSize="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CategoryTabStyle}" Checked="OnTabCelebrationChecked">
                        <emoji:TextBlock Text="🎉" FontSize="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CategoryTabStyle}" Checked="OnTabAnimalsChecked">
                        <emoji:TextBlock Text="🐶" FontSize="18"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CategoryTabStyle}" Checked="OnTabFoodChecked">
                        <emoji:TextBlock Text="🍕" FontSize="18"/>
                    </RadioButton>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                <WrapPanel x:Name="EmojiContainer" HorizontalAlignment="Center" Width="300"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
