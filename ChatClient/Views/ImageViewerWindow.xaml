<Window x:Class="ChatClient.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Preview"
        Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFileName" Text="Image.png" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtFileSize" Text="1.2 MB" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 Save Image As..." Click="OnSaveAsClick"
                            Background="#0084FF" Foreground="White" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" Padding="12,6" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="✕" Click="OnCloseClick"
                            Background="Transparent" Foreground="#94A3B8" FontSize="16"
                            BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Image Display Area -->
        <Grid Grid.Row="1" Margin="16">
            <Image x:Name="MainImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Width="160" Height="6"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
