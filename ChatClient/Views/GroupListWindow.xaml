<Window x:Class="ChatClient.GroupListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý nhóm chat" Height="680" Width="1060" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#2557D6">
                        <TextBlock Text="💬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Nhóm chat" FontSize="19" FontWeight="SemiBold" Foreground="#172033"/>
                        <TextBlock x:Name="CurrentUserTextBlock" FontSize="12" Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="＋ Tạo nhóm" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#2557D6" Foreground="White" BorderThickness="0" Click="CreateGroupButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" MinWidth="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.35*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="14" BorderBrush="#E5EAF2" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="#E5EAF2" BorderThickness="0,0,0,1" Padding="18,0">
                        <Grid>
                            <TextBlock Text="Nhóm của tôi" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#172033"/>
                            <TextBlock x:Name="GroupCountTextBlock" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#7B8498"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="GroupsListBox" Grid.Row="1" Margin="8" BorderThickness="0"
                             ItemsSource="{Binding Groups}" DisplayMemberPath="Name"
                             SelectionChanged="GroupsListBox_SelectionChanged" FontSize="15"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#E5EAF2" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="#E5EAF2" BorderThickness="0,0,0,1" Padding="22,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedGroupNameTextBlock" Text="Chọn một nhóm" FontSize="18" FontWeight="SemiBold" Foreground="#172033"/>
                                <TextBlock Text="Danh sách thành viên" FontSize="12" Foreground="#7B8498" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="AddMemberButton" Content="＋ Thêm thành viên" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#EAF0FF" Foreground="#2557D6" BorderBrush="#C9D7FF" IsEnabled="False" Click="AddMemberButton_Click"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="MembersListBox" Grid.Row="1" Margin="12" BorderThickness="0" ItemsSource="{Binding Members}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#EEF2F8">
                                        <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Username}" FontSize="14" Foreground="#27324A"/>
                                        <TextBlock Text="●" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#A8B0BF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Foreground" Value="#25B06B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5EAF2" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="Sẵn sàng" VerticalAlignment="Center" Margin="28,0" Foreground="#657087"/>
        </Border>
    </Grid>
</Window>
