<Window x:Class="ChatClient.AddMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm thành viên" Height="285" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F7F9FC" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Thêm thành viên" FontSize="22" FontWeight="SemiBold" Foreground="#172033"/>
        <TextBlock x:Name="DescriptionTextBlock" Grid.Row="1" Foreground="#6B7280" Margin="0,6,0,22" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold" Foreground="#536079" Margin="0,0,0,7"/>
            <TextBox x:Name="UsernameTextBox" Height="44" Padding="12,10" MaxLength="50" KeyDown="UsernameTextBox_KeyDown"/>
            <TextBlock Text="Người dùng cần đăng nhập ít nhất một lần trước khi được thêm." Foreground="#7B8498" FontSize="11" Margin="0,7,0,0"/>
            <TextBlock x:Name="ErrorTextBlock" Foreground="#C83434" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" Width="86" Height="40" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Thêm" Width="105" Height="40" Background="#2557D6" Foreground="White" BorderThickness="0" Click="AddButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
