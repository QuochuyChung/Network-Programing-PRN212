<Window x:Class="ChatClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập Chat App" Height="540" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F7FB">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2557D6">
            <Grid Margin="48">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="68" Height="68" CornerRadius="20" Background="#3C6CE8" HorizontalAlignment="Left">
                        <TextBlock Text="💬" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Chat cùng nhóm của bạn" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,24,0,12" TextWrapping="Wrap"/>
                    <TextBlock Text="Tạo nhóm mới, quản lý thành viên và giữ mọi cuộc trò chuyện ở cùng một nơi." Foreground="#DCE7FF" FontSize="15" LineHeight="24" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="52">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Đăng nhập" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/>
                <TextBlock Text="Nhập username để bắt đầu" FontSize="14" Foreground="#6B7280" Margin="0,6,0,28"/>

                <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold" Foreground="#536079" Margin="0,0,0,7"/>
                <TextBox x:Name="UsernameTextBox" Height="44" Padding="12,10" FontSize="14" MaxLength="50" KeyDown="UsernameTextBox_KeyDown"/>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SERVER" FontSize="11" FontWeight="SemiBold" Foreground="#536079" Margin="0,0,0,7"/>
                        <TextBox x:Name="HostTextBox" Text="127.0.0.1" Height="44" Padding="12,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PORT" FontSize="11" FontWeight="SemiBold" Foreground="#536079" Margin="0,0,0,7"/>
                        <TextBox x:Name="PortTextBox" Text="5000" Height="44" Padding="12,10"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorTextBlock" Foreground="#C83434" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <Button x:Name="LoginButton" Content="Kết nối và đăng nhập" Height="46" Margin="0,20,0,0"
                        Background="#2557D6" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="LoginButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
