<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:converters="clr-namespace:ChatClient.Converters"
        xmlns:controls="clr-namespace:ChatClient.Controls"
        Title="ChatApp Messenger" Height="680" Width="1050"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPillButton" TargetType="Button">
            <Setter Property="Background" Value="#0084FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0073E6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005BB5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ConversationItemTemplate">
            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="10" Padding="10,8" Margin="0,2" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,10,0">
                        <Ellipse Fill="{Binding AvatarColor}"/>
                        <TextBlock Text="{Binding AvatarLetter}" Foreground="White"
                                   FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding LastMessage}" FontSize="12" Foreground="#64748B"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding FormattedTime}" FontSize="11" Foreground="#94A3B8"
                                   HorizontalAlignment="Right" Margin="0,0,0,4"/>
                        <Border Background="#EF4444" CornerRadius="10" MinWidth="20" Height="20"
                                Padding="6,1" HorizontalAlignment="Right"
                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UnreadDisplay}" Foreground="White"
                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== COLUMN 0: SIDEBAR ===================== -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- User Profile Header -->
                    <Border Grid.Row="0" Padding="14,14" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0">
                                <Ellipse Fill="{Binding CurrentUserAvatarColor}"/>
                                <TextBlock Text="{Binding CurrentUserAvatarLetter}" Foreground="White"
                                           FontWeight="Bold" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUsername}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,5,0"/>
                                    <TextBlock Text="Online" FontSize="11" Foreground="#16A34A" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="2" ToolTip="Logout" Command="{Binding LogoutCommand}"
                                    Style="{StaticResource IconButton}">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#64748B"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Online Users Horizontal List -->
                    <Border Grid.Row="1" Padding="12,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="ONLINE NOW" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="2,0,0,8"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding OnlineUsers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="52" Margin="0,0,6,0" Cursor="Hand" ToolTip="{Binding}">
                                                <Grid Width="36" Height="36" HorizontalAlignment="Center">
                                                    <Ellipse Fill="#6366F1"/>
                                                    <TextBlock Text="{Binding [0]}" Foreground="White" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse Width="10" Height="10" Fill="#22C55E" Stroke="White" StrokeThickness="2"
                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                </Grid>
                                                <TextBlock Text="{Binding}" FontSize="10" Foreground="#475569"
                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Conversations Header -->
                    <Grid Grid.Row="2" Margin="14,12,14,6">
                        <TextBlock Text="Conversations" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" ToolTip="New Group Chat"
                                Command="{Binding OpenCreateGroupCommand}"
                                Style="{StaticResource IconButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#0084FF" Margin="0,0,4,0"/>
                                <TextBlock Text="New Group" FontSize="12" FontWeight="SemiBold" Foreground="#0084FF"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Conversations List -->
                    <ListBox Grid.Row="3" ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                             ItemTemplate="{StaticResource ConversationItemTemplate}"
                             BorderThickness="0" Background="Transparent"
                             Padding="6,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ===================== COLUMN 1: CHAT AREA ===================== -->
            <Grid Grid.Column="1" Background="#F8FAFC">
                <!-- Empty state -->
                <Grid Visibility="{Binding IsGroupSelected, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="80" Height="80" Background="#EEF2FF" CornerRadius="40" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#4F46E5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No conversation selected" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a group from the list or create a new group to start chatting."
                                   FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                        <Button Content="+ Create New Group" Style="{StaticResource PrimaryPillButton}"
                                Command="{Binding OpenCreateGroupCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Active Chat Panel -->
                <Grid Visibility="{Binding IsGroupSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat Header -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse Fill="{Binding SelectedConversation.AvatarColor}"/>
                                <TextBlock Text="{Binding SelectedConversation.AvatarLetter}" Foreground="White"
                                           FontWeight="Bold" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedConversation.Name}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding SelectedConversation.MemberCount, StringFormat='{}{0} members'}"
                                           FontSize="12" Foreground="#64748B"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="+ Add Member" Style="{StaticResource IconButton}"
                                        Command="{Binding OpenAddMemberCommand}" Margin="0,0,8,0"
                                        Foreground="#0084FF" FontWeight="SemiBold" FontSize="13"/>
                                <Button Content="👥 Members" Style="{StaticResource IconButton}"
                                        Command="{Binding ToggleMemberListCommand}"
                                        Foreground="#475569" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Chat Messages List -->
                    <ListBox x:Name="MessagesListBox" Grid.Row="1" Padding="18,14"
                             ItemsSource="{Binding CurrentMessages}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4" HorizontalAlignment="{Binding BubbleAlignment}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="30" Height="30" Margin="0,0,8,0"
                                              VerticalAlignment="Top" Visibility="{Binding AvatarVisibility}">
                                            <Ellipse Fill="{Binding AvatarColor}"/>
                                            <TextBlock Text="{Binding AvatarLetter}" Foreground="White"
                                                       FontWeight="Bold" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" MaxWidth="500">
                                            <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#64748B" Margin="4,0,0,2"
                                                       Visibility="{Binding SenderNameVisibility}"/>

                                            <!-- 1. Text Message Bubble -->
                                            <Border Visibility="{Binding IsTextMessage, Converter={StaticResource BoolToVis}}"
                                                    Background="{Binding BubbleBackground}" CornerRadius="14" Padding="12,9">
                                                <emoji:TextBlock Text="{Binding Content}"
                                                                 Foreground="{Binding BubbleForeground}"
                                                                 FontSize="14"
                                                                 TextWrapping="Wrap"/>
                                            </Border>

                                            <!-- 2. Image Thumbnail Card -->
                                            <Border Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                                                    CornerRadius="14" ClipToBounds="True" Background="#0F172A"
                                                    BorderBrush="#CBD5E1" BorderThickness="1"
                                                    MaxWidth="340" HorizontalAlignment="{Binding BubbleAlignment}">
                                                <Grid>
                                                    <!-- Clickable Thumbnail to Open Full Lightbox Modal -->
                                                    <Button Command="{Binding PreviewImageCommand}" Cursor="Hand" Padding="0" BorderThickness="0" Background="Transparent">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Grid>
                                                            <Image Source="{Binding ThumbnailSource}" MaxWidth="340" MaxHeight="260"
                                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsUploading}" Value="True">
                                                                                <Setter Property="Effect">
                                                                                    <Setter.Value>
                                                                                        <BlurEffect Radius="20"/>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                            <!-- Subtle hover badge: Click to view full image -->
                                                            <Border Background="#99000000" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                    Margin="8" CornerRadius="10" Padding="6,3">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsUploading}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="View" FontSize="11" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Upload Skeleton/Progress -->
                                                    <Border CornerRadius="14" Visibility="{Binding IsUploading, Converter={StaticResource BoolToVis}}" Background="#33000000">
                                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <StackPanel>
                                                                <Border Width="46" Height="46" CornerRadius="23" Background="#AA000000" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding UploadProgress, StringFormat={}{0:F0}%}" 
                                                                               Foreground="White" FontWeight="Bold" FontSize="12"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Button Content="✕ Cancel" Command="{Binding CancelUploadCommand}" Foreground="#F8FAFC"
                                                                        FontSize="11" FontWeight="SemiBold" Background="#99EF4444" BorderThickness="0"
                                                                        Cursor="Hand" HorizontalAlignment="Center" Margin="0,10,0,0" Padding="12,5">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="10"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- 3. File Attachment Card -->
                                            <Border Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"
                                                    Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    CornerRadius="14" Padding="12,10" MinWidth="270" MaxWidth="360"
                                                    HorizontalAlignment="{Binding BubbleAlignment}">
                                                <Border.CacheMode>
                                                    <BitmapCache EnableClearType="True" RenderAtScale="1"/>
                                                </Border.CacheMode>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- File Header: Icon + Info + Action Button -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- File Icon Badge -->
                                                        <Border Grid.Column="0" Width="40" Height="40" Background="#EFF6FF" CornerRadius="10" Margin="0,0,10,0">
                                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#0084FF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- File Name & Size -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Attachment.FileName}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Attachment.FormattedFileSize}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Download Button -->
                                                        <Button Grid.Column="2" Command="{Binding DownloadFileCommand}"
                                                                Visibility="{Binding ShowDownloadButton, Converter={StaticResource BoolToVis}}"
                                                                Style="{StaticResource IconButton}" ToolTip="Download File" VerticalAlignment="Center">
                                                            <Border Background="#F1F5F9" CornerRadius="8" Padding="7">
                                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#0F172A"/>
                                                            </Border>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Upload Progress Section -->
                                                    <StackPanel Grid.Row="1" Margin="0,10,0,0"
                                                                Visibility="{Binding ShowUploadProgress, Converter={StaticResource BoolToVis}}">
                                                        <ProgressBar Value="{Binding UploadProgress}" Minimum="0" Maximum="100" Height="5"
                                                                     Foreground="#0084FF" Background="#E2E8F0" Margin="0,0,0,6"/>
                                                        <Grid>
                                                            <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left"/>
                                                            <Button Content="Cancel" Command="{Binding CancelUploadCommand}" Foreground="#EF4444"
                                                                    FontSize="11" FontWeight="SemiBold" Background="Transparent" BorderThickness="0"
                                                                    Cursor="Hand" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Download Progress Section -->
                                                    <StackPanel Grid.Row="1" Margin="0,10,0,0"
                                                                Visibility="{Binding ShowDownloadProgress, Converter={StaticResource BoolToVis}}">
                                                        <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" Height="5"
                                                                     Foreground="#10B981" Background="#E2E8F0" Margin="0,0,0,6"/>
                                                        <TextBlock Text="{Binding DownloadText}" FontSize="11" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#94A3B8"
                                                       Margin="4,2,4,0" HorizontalAlignment="{Binding BubbleAlignment}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Chat Input Area -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Media & Attachment Action Buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <!-- Send Images Button -->
                                <Button Command="{Binding SendImageCommand}" Style="{StaticResource IconButton}"
                                        ToolTip="Send Images (PNG, JPG, GIF)" Margin="0,0,2,0">
                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0284C7"/>
                                </Button>

                                <!-- Send File Attachment Button -->
                                <Button Command="{Binding SendFileCommand}" Style="{StaticResource IconButton}"
                                        ToolTip="Send File (up to 500MB+)" Margin="0,0,2,0">
                                    <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#64748B"/>
                                </Button>

                                <!-- Emoji Button & Popup -->
                                <Grid>
                                    <Button x:Name="BtnEmoji" Click="OnEmojiButtonClick"
                                            Style="{StaticResource IconButton}" ToolTip="Insert Color Emoji">
                                        <emoji:TextBlock Text="😀" FontSize="18"/>
                                    </Button>

                                    <Popup x:Name="EmojiPopup" Placement="Top" PlacementTarget="{Binding ElementName=BtnEmoji}"
                                           StaysOpen="False" AllowsTransparency="True">
                                        <controls:EmojiPickerPopup x:Name="EmojiPickerControl" EmojiSelected="OnEmojiSelected"/>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <!-- Text Input Box -->
                            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="18" Padding="12,8">
                                <Grid>
                                    <TextBlock Text="Type a message... (Press Enter to send)"
                                               Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center"
                                               IsHitTestVisible="False" Margin="4,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MessageInput}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MessageInput}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <emoji:RichTextBox x:Name="TxtMessageInput"
                                                       Text="{Binding MessageInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Background="Transparent" BorderThickness="0"
                                                       FontSize="14" Foreground="#0F172A"
                                                       VerticalAlignment="Center"
                                                       PreviewKeyDown="OnMessageInputKeyDown">
                                        <emoji:RichTextBox.Resources>
                                            <Style TargetType="{x:Type Paragraph}">
                                                <Setter Property="Margin" Value="0"/>
                                            </Style>
                                        </emoji:RichTextBox.Resources>
                                    </emoji:RichTextBox>
                                </Grid>
                            </Border>

                            <!-- Send Button -->
                            <Button Grid.Column="2" Command="{Binding SendMessageCommand}"
                                    Style="{StaticResource PrimaryPillButton}"
                                    Margin="8,0,0,0" Width="42" Height="42" Padding="0">
                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================== COLUMN 2: MEMBERS SIDEBAR ===================== -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0"
                    Width="230"
                    Visibility="{Binding IsMemberListOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,14" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Group Members" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Content="✕" HorizontalAlignment="Right" Command="{Binding ToggleMemberListCommand}"
                                    Style="{StaticResource IconButton}" Foreground="#64748B"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding CurrentGroupMembers}"
                             BorderThickness="0" Background="Transparent" Padding="6,4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,8,0">
                                        <Ellipse Fill="{Binding AvatarColor}"/>
                                        <TextBlock Text="{Binding AvatarLetter}" Foreground="White"
                                                   FontWeight="Bold" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Padding="10" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                        <Button Content="+ Add Member" Style="{StaticResource PrimaryPillButton}"
                                Command="{Binding OpenAddMemberCommand}" HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== TOAST NOTIFICATION POPUP ===================== -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0"
                Width="320" Background="#0F172A" CornerRadius="12" Padding="14,12"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#38BDF8"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ToastTitle}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <emoji:TextBlock Text="{Binding ToastMessage}" FontSize="12" Foreground="#94A3B8"
                                     TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Foreground="#94A3B8" Command="{Binding CloseToastCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Margin="6,-4,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
