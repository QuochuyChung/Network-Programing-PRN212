<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat" Height="500" Width="800"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Online Users Sidebar -->
        <Border Grid.Column="0" Background="#F0F0F0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Online Users"
                           FontSize="16" FontWeight="Bold" Margin="10,10,10,10"/>
                <ItemsControl x:Name="OnlineUsersList" Margin="10,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="10" Height="10" Fill="Green" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding}" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Chat Area Placeholder -->
        <Border Grid.Column="1" Background="White">
            <Grid>
                <TextBlock Text="Select a group to start chatting"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="Gray"/>
            </Grid>
        </Border>
    </Grid>
</Window>
